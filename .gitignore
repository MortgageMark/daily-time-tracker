# Written by the Netlify build command on every deploy — never commit it.
# A committed copy would pin the update check to a stale build id.
version.json

# scratch files
_*.txt
_*.sh
_*.py

# Per-machine Claude Code state (permission grants, local overrides).
# .claude/launch.json IS committed — it is shared, generic dev-server config.
.claude/settings.local.json
.claude/*.local.json

# OS cruft
Thumbs.db
desktop.ini
.DS_Store
